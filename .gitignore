# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.pytest_cache/
.pytest-cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Venvs
.venv/
venv/
.venv-*/

# VSCode (share later if desired)
.vscode/

# Project artifacts
runs/
agent_revisions/
*.blob
*.jsonl
# V6 Phase 2B.9: frozen historical-readability fixture replays for retired
# rulesets (bytefray-rules-2-alpha1/-alpha11), committed deliberately --
# see client/tests/test_replay_status.py's module docstring.
!client/tests/fixtures/replay_status/*.jsonl
# V6 Phase 2B.10 Scope B: frozen historical-immutability fixture replays for
# retired rulesets (bytefray-rules-4-alpha1/-alpha2), committed deliberately --
# see engine/tests/test_v4_historical_immutability.py's module docstring.
!engine/tests/fixtures/v4_historical_immutability/*.jsonl
# V6 Phase 2B.10 Scope B: a frozen real bytefray-rules-4-alpha1 replay+trace
# pair, committed deliberately because stable bytefray-rules-4 structurally
# cannot reproduce this fixture's precondition (it is not a member of
# VULNERABLE_CORE_RULESET_IDS, so get_entrant_statuses().core is always None
# for it) -- see client/tests/test_perspective_card_knowledge.py's module
# docstring.
!client/tests/fixtures/perspective_card_knowledge/*.jsonl

# Derived, disposable application cache. In a source checkout the data root is
# the repository itself, so the rebuildable Replay History SQLite index lands
# in <repo>/cache/replay_history/. It is regenerated from runs/ on demand and
# must never be committed.
/cache/

# Source checkouts use root agents/ as the writable runtime catalogue.
# Canonical starter agents live under battle_engine/data/starter_agents/.
# Existing tracked historical/reproducibility fixtures remain tracked.
/agents/

# Qualification run scratch/output (ad hoc per-run names, e.g. rc2-final-win-*)
*-junit.xml
*-scratch/

# Committed-by-accident PyInstaller scratch/output trees (not the canonical
# /build/ and /dist/ paths tools/build_win.ps1 actually writes to)
/builds/
/work/

# Local AI dev tooling (optional, generated artifacts)
tools/local_ai/local-ai-results/

# Logs / temps / backups
*.log
*.tmp
*.bak
*.old
*.orig

summary.json
engine/src/battle_engine/cli.py.*

/build/
/dist/
/*.spec
.idea/
.env
