global-exclude *.py[cod]

# V6 Phase 2B.12 retains research inputs in the repository but removes every
# retired Agent API v1 / VM execution resource from installable artifacts.
prune engine/src/battle_engine/data/benchmarks
prune engine/src/battle_engine/data/reference_agents
prune engine/src/battle_engine/data/v3_closeout_agents
prune engine/src/battle_engine/data/v3_phase7_agents
prune engine/src/battle_engine/data/agent_template
prune engine/src/battle_engine/data/agent_template_annotated
prune engine/src/battle_engine/data/starter_agents/adaptive
prune engine/src/battle_engine/data/starter_agents/claimer
prune engine/src/battle_engine/data/starter_agents/hunter
prune engine/src/battle_engine/data/starter_agents/raider
prune engine/src/battle_engine/data/starter_agents/runner
prune engine/src/battle_engine/data/starter_agents/seeker
prune engine/src/battle_engine/data/starter_agents/sentinel
prune engine/src/battle_engine/data/starter_agents/spiral
prune engine/src/battle_engine/data/starter_agents/strider
prune engine/src/battle_engine/data/starter_agents/wanderer
prune engine/src/battle_engine/data/starter_agents/writer

# The Classic retirement keeps the V4/V5 starters in the repository as the
# research benchmark population but no longer installs or ships them.
prune engine/src/battle_engine/data/starter_agents/v4_claimer
prune engine/src/battle_engine/data/starter_agents/v4_concentrated_attacker
prune engine/src/battle_engine/data/starter_agents/v4_defender_scout
prune engine/src/battle_engine/data/starter_agents/v4_local_defender
prune engine/src/battle_engine/data/starter_agents/v4_quorum
prune engine/src/battle_engine/data/starter_agents/v4_scout
prune engine/src/battle_engine/data/starter_agents/v5_core_defender
prune engine/src/battle_engine/data/starter_agents/v5_dual_team
prune engine/src/battle_engine/data/starter_agents/v5_region_attacker
prune engine/src/battle_engine/data/starter_agents/v5_scout_striker

# The sdist is a buildable/installable source distribution, not a full
# development checkout -- it ships engine/src, client/src, and app/, not
# any test suite. Root tests/ (Designer/GUI tests) was previously included
# by setuptools' sdist defaults while engine/tests/, client/tests/, and
# pytest.ini were not, which is a non-runnable partial fragment either way.
# Exclude root tests/ rather than adding the missing pieces to make the
# accidental partial inclusion internally consistent.
prune tests
